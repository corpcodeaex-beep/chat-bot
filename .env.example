# Copy this file to ".env.local" and fill in the values.

# Postgres database (required). Free at https://neon.tech - tables are created automatically.
DATABASE_URL=

# Admin login: email "admin" (or ADMIN_EMAIL) + ADMIN_PASSWORD. CHANGE the password before going live.
ADMIN_PASSWORD=admin123
# ADMIN_EMAIL=admin

# Signs logins and encrypts saved WhatsApp tokens (required in production, 32+ random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public address of the app once deployed (used in install code and WhatsApp webhook), e.g. https://chatdesk.vercel.app
# PUBLIC_APP_URL=

# Email for "forgot password" links. Without it no email is sent and the admin gets a notification instead.
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to the company. With Gmail a different address only works if it is added under Gmail "Send mail as".
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
# Alternative to SMTP: Resend (https://resend.com/api-keys), used only when SMTP is not set
# RESEND_API_KEY=

# Which AI to use: auto | demo | gemini | anthropic | groq
# "auto" picks the first key it finds (Anthropic, then Gemini, then Groq), else demo.
AI_PROVIDER=auto

# Google Gemini - FREE key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (default; use gemini-3.6-flash for smarter but slower answers)

# Groq - FREE key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b   (default; free plan 1,000 requests/day, 8,000 tokens/minute per model)

# Anthropic Claude - paid, best quality: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# WhatsApp Cloud API (Meta). Webhook URL: https://YOUR-APP/api/whatsapp/webhook
# Any random text; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app: App settings > Basic > App Secret (needed to accept incoming messages)
WHATSAPP_APP_SECRET=
# true = log replies instead of sending them (testing)
WHATSAPP_DRY_RUN=false
# WHATSAPP_API_VERSION=v23.0
